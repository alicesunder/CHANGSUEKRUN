# ============================================================
# CHANG SUEK RUN 2027 — ตัวแปรสภาพแวดล้อม (คัดลอกเป็น .env แล้วกรอก)
# ============================================================

# --- แอดมิน (จำเป็น) ---------------------------------------
ADMIN_USERNAME=admin
# อย่างน้อย 10 ตัวอักษร ถ้าไม่ตั้ง ระบบจะสุ่มรหัสใหม่ทุกครั้งที่เปิดเซิร์ฟเวอร์ และพิมพ์ไว้ใน log
ADMIN_PASSWORD=
# สตริงสุ่มยาว ๆ ใช้เซ็น token ล็อกอิน (ถ้าไม่ตั้ง แอดมินต้องล็อกอินใหม่ทุกครั้งที่รีสตาร์ท)
ADMIN_SESSION_SECRET=

# --- โดเมนของเว็บ (ไม่บังคับ) ---------------------------------------
# ใช้ทำลิงก์รูปตอนแชร์ใน LINE/Facebook ถ้าไม่ตั้ง ระบบใช้โดเมนที่ผู้ใช้เข้ามาอัตโนมัติ
SITE_URL=

# --- ฐานข้อมูล (Supabase Postgres) -------------------------------------
# ใส่ค่านี้เมื่อรันบน Vercel/โฮสต์จริง: Supabase → Connect → "Transaction pooler" (พอร์ต 6543)
# แล้วแทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูล ถ้าเว้นว่าง เว็บจะใช้ฐานข้อมูลในเครื่อง (เฉพาะทดสอบ) ที่โฟลเดอร์ data/
DATABASE_URL=

# --- ที่เก็บข้อมูล (สำคัญมาก) ----------------------------------
# โฟลเดอร์เก็บคำสั่งซื้อและรูปสลิป ต้องเป็นพื้นที่ถาวร ไม่หายเมื่อรีสตาร์ท
DATA_DIR=./data

# --- ระบบชำระเงิน: Omise PromptPay (จำเป็น) ----------------------------
# ถ้ายังไม่ใส่ key หน้าเว็บจะปิดรับชำระเงิน (สมัครไม่ได้)
# skey_test_... = โหมดทดสอบ (ไม่รับเงินจริง) · skey_... = รับเงินจริง
# อย่าลืมตั้ง Webhook ใน Omise Dashboard เป็น https://<โดเมนเว็บ>/api/payment-webhook
# เงินเข้าบัญชีร้านค้า Omise ก่อน แล้ว Omise โอนเข้าบัญชีธนาคารที่ผูกไว้ใน Omise Dashboard
OMISE_SECRET_KEY=
